# Database
DATABASE_URL=./data/sqlite.db

# Google AI (Gemini) - Required
# Get your free API key at: https://ai.google.dev
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Backblaze B2 Storage - Required
# Sign up at: https://www.backblaze.com/b2
# Create a bucket and generate S3-compatible application keys
B2_APPLICATION_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=us-west-004
B2_PUBLIC_URL_BASE=https://s3.us-west-004.backblazeb2.com/your-bucket-name
# Presigned image URL TTL in seconds. Must be between 1 and 604800.
IMAGE_URL_TTL_SECONDS=900

# OpenAI (DALL-E) - Optional
# Get API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
